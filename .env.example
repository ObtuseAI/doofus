# Copy to .env (gitignored). Never commit real keys.

# OpenRouter (default live provider)
OPENROUTER_API_KEY=
DOOFUS_LIVE_PROVIDER=openrouter
DOOFUS_MODEL_PROVIDER=openrouter
DOOFUS_OPENROUTER_MODEL_ALIAS=deepseekv4flash
DOOFUS_OPENROUTER_MODEL_ID=
DOOFUS_MODEL_NAME=deepseek/deepseek-v4-flash
DOOFUS_PROVIDER_FALLBACKS_DISABLED=1
DOOFUS_LIVE_MAX_MODEL_CALLS=2
DOOFUS_LIVE_MAX_COST_USD=0.05
DOOFUS_MODEL_TIMEOUT_SECONDS=120
# DOOFUS_AUTONOMOUS_LIVE_MODE=1
DOOFUS_MODEL_TEMPERATURE=0.6
DOOFUS_MAX_DAILY_COST_USD=5
DOOFUS_MAX_MODEL_CALLS_PER_HOUR=60

# Cursor Composer 2.5 — set DOOFUS_MODEL_PROVIDER=cursor and run scripts/doofus_enable_cursor_composer.py
# Auth option A (recommended): local agent CLI — run once: agent login
# Auth option B: CURSOR_API_KEY from https://cursor.com/dashboard/cloud-agents
# DOOFUS_PREFER_CURSOR=1
# DOOFUS_CURSOR_MODEL=composer-2.5
# DOOFUS_CURSOR_USE_AGENT_CLI=1
# DOOFUS_CURSOR_MUTATION_BATCH=8

# Experimental metacognitive cortex. Shadow records and calibrates without control.
DOOFUS_METACOGNITION_MODE=shadow
DOOFUS_METACOGNITION_TARGET_ID=doofus
DOOFUS_METACOGNITION_CALIBRATION_WINDOW=200
DOOFUS_METACOGNITION_MIN_ONLINE_SAMPLES=8
DOOFUS_METACOGNITION_MIN_CANDIDATES=8
DOOFUS_METACOGNITION_MAX_CANDIDATES=48
DOOFUS_METACOGNITION_MAX_ARENA_REPETITIONS=4
DOOFUS_METACOGNITION_MAX_REPLAY_DEPTH=5
